---
/**
 * Jamwidgets Form Component
 *
 * A wrapper component that handles form submission to Jamwidgets.
 * You provide your own form fields via the default slot.
 *
 * @example
 * <Form siteKey={import.meta.env.JAMWIDGETS_SITE_KEY} formSlug="contact">
 *   <input name="name" placeholder="Name" required />
 *   <input name="email" type="email" placeholder="Email" required />
 *   <textarea name="message" placeholder="Message" required></textarea>
 *   <button type="submit">Send</button>
 * </Form>
 */

interface Props {
  /** Your site key (required) */
  siteKey: string;
  /** The form slug as configured in Jamwidgets (required) */
  formSlug: string;
  /** Base URL of your Jamwidgets instance (default: 'https://jamwidgets.com') */
  endpoint?: string;
  /** Theme preset. Defaults to inheriting the host page. */
  theme?: "inherit" | "light" | "dark" | "auto";
  /** CSS class to add to the form */
  class?: string;
}

const DEFAULT_ENDPOINT = "https://jamwidgets.com";
const API_PATH = "/api/v1";

const {
  siteKey,
  formSlug,
  endpoint = DEFAULT_ENDPOINT,
  theme = "inherit",
  class: className = "",
} = Astro.props;

// Build the API URL
const baseUrl = endpoint.replace(/\/+$/, "") + API_PATH;

import PoweredBy from "./PoweredBy.astro";
import Theme from "./Theme.astro";
---

<Theme />
<form
  class:list={["jamwidgets-form", `jamwidgets-theme-${theme}`, className]}
  data-jamwidgets-form
  data-endpoint={baseUrl}
  data-site-key={siteKey}
  data-form-slug={formSlug}
>
  <slot />

  <!-- Honeypot field for spam protection (hidden from users, catches bots) -->
  <div style="position: absolute; left: -9999px;" aria-hidden="true">
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <!-- Success/Error message container (hidden by default) -->
  <div class="jamwidgets-form-message" style="display: none;" aria-live="polite"></div>

  <PoweredBy siteKey={siteKey} endpoint={endpoint} />
</form>

<script>
  import { generateUUID, getAttributionHeaders, getVisitorId } from "@jamwidgets/core";

  interface FormSubmitResponse {
    success: boolean;
    message: string;
  }

  // Store form load timestamps for spam detection
  const formTimestamps = new WeakMap<Element, number>();
  const requestIds = new WeakMap<Element, string>();
  const requestBodies = new WeakMap<Element, string>();

  document.querySelectorAll("[data-jamwidgets-form]").forEach((form) => {
    // Record when form was loaded (for time-based spam detection)
    formTimestamps.set(form, Math.floor(Date.now() / 1000));
    requestIds.set(form, generateUUID());

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formEl = e.target as HTMLFormElement;
      const endpoint = formEl.dataset.endpoint;
      const siteKey = formEl.dataset.siteKey;
      const formSlug = formEl.dataset.formSlug;
      const messageEl = formEl.querySelector(".jamwidgets-form-message") as HTMLElement | null;
      const submitBtn = formEl.querySelector('[type="submit"]') as HTMLButtonElement | null;

      if (!endpoint || !siteKey || !formSlug) {
        const missing = [];
        if (!endpoint) missing.push("endpoint");
        if (!formSlug) missing.push("formSlug");
        if (!siteKey) {
          missing.push("siteKey (check JAMWIDGETS_SITE_KEY in your .env)");
        }
        console.error(`Jamwidgets form missing required props: ${missing.join(", ")}`);
        return;
      }

      // Collect form data
      const formData = new FormData(formEl);
      const data: Record<string, unknown> = {};
      formData.forEach((value, key) => {
        data[key] = value;
      });

      // Add timestamp for time-based spam detection
      const loadTimestamp = formTimestamps.get(formEl);
      if (loadTimestamp) {
        data._seriph_ts = loadTimestamp;
      }
      const comparableBody = JSON.stringify(data);
      if (requestBodies.get(formEl) !== comparableBody) {
        requestIds.set(formEl, generateUUID());
        requestBodies.set(formEl, comparableBody);
      }
      data._seriph_id = requestIds.get(formEl) || generateUUID();

      // Dispatch loading event
      formEl.dispatchEvent(new CustomEvent("jamwidgets:loading"));

      // Disable submit button
      if (submitBtn) {
        submitBtn.disabled = true;
      }

      try {
        const response = await fetch(`${endpoint}/forms/${formSlug}/submit`, {
          method: "POST",
          headers: {
            ...getAttributionHeaders(),
            "Content-Type": "application/json",
            "X-Jamwidgets-Key": siteKey,
            "X-Jamwidgets-Visitor": getVisitorId(),
          },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          const errorText = await response.text();
          throw new Error(errorText || "Submission failed");
        }

        const result: FormSubmitResponse = await response.json();
        requestIds.set(formEl, generateUUID());
        requestBodies.delete(formEl);

        // Show success message
        if (messageEl) {
          messageEl.textContent = result.message;
          messageEl.style.display = "block";
          messageEl.className = "jamwidgets-form-message jamwidgets-form-success";
        }

        // Dispatch success event with response data
        formEl.dispatchEvent(
          new CustomEvent("jamwidgets:success", {
            detail: result,
          }),
        );

        // Reset form on success
        formEl.reset();
      } catch (error) {
        // Show error message
        if (messageEl) {
          messageEl.textContent = error instanceof Error ? error.message : "Something went wrong";
          messageEl.style.display = "block";
          messageEl.className = "jamwidgets-form-message jamwidgets-form-error";
        }

        formEl.dispatchEvent(
          new CustomEvent("jamwidgets:error", {
            detail: error,
          }),
        );
      } finally {
        // Re-enable submit button
        if (submitBtn) {
          submitBtn.disabled = false;
        }
      }
    });
  });
</script>

<style is:global>
  @layer jamwidgets {
    .jamwidgets-form-message {
      margin-top: 1rem;
      padding: 0.75rem 1rem;
      border-radius: 0.375rem;
    }

    .jamwidgets-form-success {
      background-color: var(--jamwidgets-success-bg);
      color: var(--jamwidgets-success-text);
      border: 1px solid var(--jamwidgets-success-border);
    }

    .jamwidgets-form-error {
      background-color: var(--jamwidgets-error-bg);
      color: var(--jamwidgets-error-text);
      border: 1px solid var(--jamwidgets-error-border);
    }
  }
</style>
