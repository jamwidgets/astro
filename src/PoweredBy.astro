---
/**
 * Jamwidgets "Powered by" footer.
 *
 * Rendered at the bottom of a drop-in widget. It hydrates hidden and only
 * reveals itself when the site is on the Free tier — the gate is the
 * `showPoweredBy` flag from `GET /api/v1/site`. Team sites keep it hidden, and
 * if the config fetch fails we stay hidden so a
 * paying site is never wrongly branded.
 *
 * Included by the block widgets (Comments, Form, Subscribe, Poll, Feedback,
 * Waitlist); not the ambient ones (Reactions, Views, Announcements).
 */
interface Props {
  /** Your site key (required) */
  siteKey: string;
  /** Base URL of your Jamwidgets instance (default: 'https://jamwidgets.com') */
  endpoint?: string;
}

const DEFAULT_ENDPOINT = "https://jamwidgets.com";

const { siteKey, endpoint = DEFAULT_ENDPOINT } = Astro.props;
---

<div
  class="jamwidgets-powered-by"
  data-jamwidgets-powered-by
  data-endpoint={endpoint}
  data-site-key={siteKey}
  hidden
>
  <a href="https://jamwidgets.com/?utm_source=powered_by" target="_blank" rel="noopener noreferrer">
    Powered by Jamwidgets
  </a>
</div>

<script>
  // Reveal the footer only when the site config explicitly enables it.
  // Core fetches site config once per (endpoint, siteKey) and returns null on
  // any failure, so the footer stays hidden (never brand a paying site).
  import { fetchSiteConfig } from "@jamwidgets/core";

  document.querySelectorAll<HTMLElement>("[data-jamwidgets-powered-by]").forEach((el) => {
    const endpoint = el.dataset.endpoint;
    const siteKey = el.dataset.siteKey;
    if (!endpoint || !siteKey) return;
    fetchSiteConfig({ siteKey, endpoint }).then((config) => {
      if (config?.showPoweredBy === true) el.removeAttribute("hidden");
    });
  });
</script>

<style>
  .jamwidgets-powered-by {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    line-height: 1;
  }
  .jamwidgets-powered-by a {
    color: var(--jamwidgets-color-muted, color-mix(in srgb, currentColor 55%, transparent));
    text-decoration: none;
  }
  .jamwidgets-powered-by a:hover {
    text-decoration: underline;
  }
</style>
